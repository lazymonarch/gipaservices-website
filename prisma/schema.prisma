generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id          String   @id @default(uuid())
  fullName    String
  companyName String?
  email       String
  phone       String?
  message     String
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model DriverApplication {
  id               String   @id @default(uuid())
  fullName         String
  address          String
  phone            String
  email            String
  licenceType      String
  experienceYears  Int
  rightToWork      Boolean
  cpcStatus        String?
  hgvCategory      String?
  availability     String?
  cvFileUrl        String
  ipAddress        String?
  createdAt        DateTime @default(now())
}