DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gipa_logistics?connection_limit=10"

ZEPTOMAIL_SEND_TOKEN="your_zeptomail_send_token"
ZEPTOMAIL_FROM_EMAIL="noreply@your-verified-domain.com"
CONTACT_NOTIFICATION_TO="ops@example.com"
DRIVER_NOTIFICATION_TO="hr@example.com"
ZOHO_CLIENT_ID="your_zoho_client_id"
ZOHO_CLIENT_SECRET="your_zoho_client_secret"
ZOHO_REFRESH_TOKEN="your_zoho_refresh_token"
ZOHO_WORKDRIVE_DRIVER_FOLDER_ID="your_driver_folder_id"
ZOHO_WORKDRIVE_WAREHOUSE_FOLDER_ID="your_warehouse_folder_id"

# Cloudinary — NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME is used in the client. API key/secret are upload-only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
